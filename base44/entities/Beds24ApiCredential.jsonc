{
  "name": "Beds24ApiCredential",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Beds24 property ID"
    },
    "api_enabled": {
      "type": "boolean",
      "default": false
    },
    "api_base_url": {
      "type": "string",
      "default": "https://api.beds24.com/v2"
    },
    "require_login_before_booking": {
      "type": "boolean",
      "default": false,
      "description": "Block non-logged-in guests from proceeding to Beds24"
    },
    "return_url": {
      "type": "string",
      "default": "https://krone-ammesso.de/booking-confirmed"
    },
    "last_manual_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": []
}