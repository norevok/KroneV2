{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "title_de": {
      "type": "string",
      "description": "German headline"
    },
    "title_en": {
      "type": "string",
      "description": "English headline"
    },
    "subtitle_de": {
      "type": "string",
      "description": "German subheadline"
    },
    "subtitle_en": {
      "type": "string",
      "description": "English subheadline"
    },
    "image_url": {
      "type": "string",
      "description": "Slide image URL"
    },
    "cta_label_de": {
      "type": "string"
    },
    "cta_label_en": {
      "type": "string"
    },
    "cta_link": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title_de",
    "image_url"
  ]
}