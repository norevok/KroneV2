{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string"
    },
    "caption_de": {
      "type": "string"
    },
    "caption_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "hotel",
        "zimmer",
        "restaurant",
        "events",
        "umgebung"
      ],
      "default": "hotel"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "alt_text": {
      "type": "string"
    }
  },
  "required": [
    "image_url"
  ]
}